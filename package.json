{
  "name": "@yuriyapostol/dyvo-vitepress-theme",
  "version": "0.2.3",
  "description": "Reusable VitePress theme, features, and utilities",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config/createConfig.ts",
      "import": "./dist/config/createConfig.js"
    },
    "./features/comments": {
      "types": "./src/features/comments/index.ts",
      "import": "./src/features/comments/index.ts"
    },
    "./features/news": {
      "types": "./src/features/news/index.ts",
      "import": "./src/features/news/index.ts"
    },
    "./theme/config": {
      "types": "./src/theme/config.ts",
      "import": "./dist/theme/config.js"
    },
    "./shared/i18n": {
      "types": "./src/shared/i18n.ts",
      "import": "./dist/shared/i18n.js"
    }
  },
  "files": [
    "index.d.ts",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:runtime",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "vitepress",
    "theme",
    "vue",
    "documentation"
  ],
  "dependencies": {
    "@yuriyapostol/dyvo-vue-ui": "file:../dyvo-vue-ui",
    "@vueuse/core": "^12.8.2"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@giscus/vue": "^3.1.1",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.20",
    "vue-tsc": "^2.1.10"
  }
}
